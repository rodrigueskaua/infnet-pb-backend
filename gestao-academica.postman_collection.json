          }
        },
        {
          "name": "Criar atividade",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/atividades", "host": ["{{baseUrl}}"], "path": ["api","atividades"]},
            "body": {"mode": "raw", "raw": "{\n  \"titulo\": \"Trabalho de POO\",\n  \"descricao\": \"Implemente um sistema com herança e polimorfismo\",\n  \"dataPrazo\": \"2026-06-30T23:59:00\",\n  \"arquivoApoio\": \"enunciado.pdf\",\n  \"turmaId\": 1,\n  \"professorId\": 2\n}", "options": {"raw": {"language": "json"}}}
          }
        },
        {
          "name": "Minhas atividades",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/atividades/professor/2", "host": ["{{baseUrl}}"], "path": ["api","atividades","professor","2"]},
            "description": "Substitua `2` pelo ID do professor."
          }
        },
        {
          "name": "Ver submissões de uma atividade",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/submissoes/atividade/1", "host": ["{{baseUrl}}"], "path": ["api","submissoes","atividade","1"]}
          }
        },
        {
          "name": "Ver submissão por ID",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/submissoes/1", "host": ["{{baseUrl}}"], "path": ["api","submissoes","1"]}
          }
        },
        {
          "name": "Buscar usuário por ID",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/1", "host": ["{{baseUrl}}"], "path": ["api","usuarios","1"]}
          }
        },
        {
          "name": "Minhas notificações",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/notificacoes/minhas", "host": ["{{baseUrl}}"], "path": ["api","notificacoes","minhas"]}
          }
        },
        {
          "name": "Marcar notificação como lida",
