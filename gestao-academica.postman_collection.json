{
  "info": {
    "name": "Gestão Acadêmica API",
    "_postman_id": "gestao-academica-collection",
    "description": "API REST do sistema de gestão acadêmica.\n\n**Como usar:**\n1. Execute o login na pasta do perfil desejado\n2. O token é salvo automaticamente na variável `token` da coleção\n3. Todas as demais requisições usam `{{token}}` no header `X-Token`\n\n**Erros de autenticação:**\n- `401` — sem token ou token inválido\n- `403` — token válido, mas perfil sem permissão",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080", "type": "string"},
    {"key": "token", "value": "", "type": "string", "description": "Preenchido automaticamente após o login"}
  ],
  "item": [
    {
      "name": "0. Autenticação (Público)",
      "description": "Rotas abertas — não exigem token.",
      "item": [
        {
          "name": "Registrar Aluno",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/registrar", "host": ["{{baseUrl}}"], "path": ["api","usuarios","registrar"]},
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"João Aluno\",\n  \"email\": \"joao@aluno.com\",\n  \"senha\": \"123456\",\n  \"papel\": \"ALUNO\"\n}", "options": {"raw": {"language": "json"}}}
          }
        },
        {
          "name": "Registrar Professor",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/registrar", "host": ["{{baseUrl}}"], "path": ["api","usuarios","registrar"]},
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Prof. Maria\",\n  \"email\": \"maria@professor.com\",\n  \"senha\": \"123456\",\n  \"papel\": \"PROFESSOR\"\n}", "options": {"raw": {"language": "json"}}}
          }
        },
        {
          "name": "Registrar Diretor",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/registrar", "host": ["{{baseUrl}}"], "path": ["api","usuarios","registrar"]},
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Diretor Carlos\",\n  \"email\": \"carlos@diretor.com\",\n  \"senha\": \"123456\",\n  \"papel\": \"DIRETOR\"\n}", "options": {"raw": {"language": "json"}}}
          }
        },
        {
          "name": "Login (salva token automaticamente)",
          "event": [{"listen": "test", "script": {"exec": ["var j = pm.response.json(); if (j.token) pm.collectionVariables.set('token', j.token);"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/login", "host": ["{{baseUrl}}"], "path": ["api","usuarios","login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"joao@aluno.com\",\n  \"senha\": \"123456\"\n}", "options": {"raw": {"language": "json"}}},
            "description": "Retorna `token`, `id`, `nome`, `email`, `papel`. Token é salvo automaticamente."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/logout", "host": ["{{baseUrl}}"], "path": ["api","usuarios","logout"]}
          }
        }
      ]
    },
    {
      "name": "1. Perfil ALUNO",
      "description": "Endpoints acessíveis por usuários com perfil ALUNO.\n\nFaça login com um usuário ALUNO antes de usar estas rotas.",
      "item": [
        {
          "name": "Login como Aluno",
          "event": [{"listen": "test", "script": {"exec": ["var j = pm.response.json(); if (j.token) pm.collectionVariables.set('token', j.token);"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/login", "host": ["{{baseUrl}}"], "path": ["api","usuarios","login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"joao@aluno.com\",\n  \"senha\": \"123456\"\n}", "options": {"raw": {"language": "json"}}}
          }
        },
        {
          "name": "Ver meu perfil",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/usuarios/me", "host": ["{{baseUrl}}"], "path": ["api","usuarios","me"]}
          }
        },
        {
          "name": "Listar minhas turmas",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/turmas/aluno/1", "host": ["{{baseUrl}}"], "path": ["api","turmas","aluno","1"]},
            "description": "Substitua `1` pelo ID do aluno logado."
          }
        },
        {
          "name": "Listar atividades (todas)",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/atividades", "host": ["{{baseUrl}}"], "path": ["api","atividades"]}
          }
        },
        {
          "name": "Listar atividades da turma",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/atividades/turma/1", "host": ["{{baseUrl}}"], "path": ["api","atividades","turma","1"]},
            "description": "Substitua `1` pelo ID da turma."
          }
        },
        {
          "name": "Buscar atividade por ID",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/atividades/1", "host": ["{{baseUrl}}"], "path": ["api","atividades","1"]}
          }
        },
        {
          "name": "Submeter resposta (upload arquivo) — DS-UC04",
          "request": {
            "method": "POST",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/submissoes?atividadeId=1&alunoId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api","submissoes"],
              "query": [
                {"key": "atividadeId", "value": "1"},
                {"key": "alunoId", "value": "1"}
              ]
            },
            "body": {"mode": "formdata", "formdata": [{"key": "arquivo", "type": "file", "description": "Arquivo de resposta"}]},
            "description": "Valida o prazo, salva o arquivo em data/uploads/ e notifica o professor. Retorna 400 se prazo encerrado."
          }
        },
        {
          "name": "Minhas submissões",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/submissoes/aluno/1", "host": ["{{baseUrl}}"], "path": ["api","submissoes","aluno","1"]},
            "description": "Substitua `1` pelo ID do aluno."
          }
        },
        {
          "name": "Minhas notificações",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/notificacoes/minhas", "host": ["{{baseUrl}}"], "path": ["api","notificacoes","minhas"]},
            "description": "Lista notificações do usuário logado."
          }
        },
        {
          "name": "Marcar notificação como lida",
          "request": {
            "method": "PATCH",
            "header": [{"key": "X-Token", "value": "{{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/notificacoes/1/lida", "host": ["{{baseUrl}}"], "path": ["api","notificacoes","1","lida"]}
          }
        }
      ]
    },
    {
      "name": "2. Perfil PROFESSOR",
